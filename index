        // ==========================================
        // 核心函數：highlightBlank(sentence, word)
        // 例句挖空與粗體高亮 (防載入空白)
        // ==========================================
        window.highlightBlank = function(sentence, word, isClozeMode = false) {
            if (!sentence) return "";
            if (!word) return sentence;

            // 處理特殊片語與文法標記的匹配規則
            let searchPatterns = [];
            const rawWord = word.trim();

            if (rawWord === "for (prep.)") searchPatterns = ["for"];
            else if (rawWord === "by (prep.)") searchPatterns = ["by"];
            else if (rawWord === "will / be going to") searchPatterns = ["are going to", "is going to", "am going to", "will"];
            else if (rawWord === "un- / dis- / in-") searchPatterns = ["un-, dis-, or in-", "un-", "dis-", "in-"];
            else if (rawWord === "about / around") searchPatterns = ["around", "about"];
            else if (rawWord === "the + adj.") searchPatterns = ["the elderly"];
            else if (rawWord === "fill A with B") searchPatterns = ["fill the glass with"];
            else if (rawWord === "add (sth) up") searchPatterns = ["add all these numbers up", "add up"];
            else if (rawWord === "take one's mind off...") searchPatterns = ["take his mind off", "take one's mind off"];
            else if (rawWord === "feed on sth") searchPatterns = ["feed on"];
            else if (rawWord === "形容詞比較級") searchPatterns = ["bigger and heavier than"];
            else if (rawWord === "eat one's fill") searchPatterns = ["eat their fill", "eat one's fill"];
            else if (rawWord === "can't get enough of sth") searchPatterns = ["can't get enough of"];
            else if (rawWord === "also, too, as well") searchPatterns = ["as well", "also", "too"];
            else if (rawWord === "the same N as...") searchPatterns = ["the same backpack as"];
            else if (rawWord === "For one thing ..., For another (thing)...") searchPatterns = ["for one thing", "for another"];
            else if (rawWord === "feel sorry for sb/sth") searchPatterns = ["feel sorry for"];
            else if (rawWord === "thank sb for N/V-ing") searchPatterns = ["thank our parents for"];
            else {
                // 一般單字與片語：支援常見動詞變化 (s, es, ed, ing, ran, spun 等)
                const escaped = rawWord.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                searchPatterns = [escaped];
                if (rawWord === "run out of") searchPatterns.unshift("ran out of");
                if (rawWord === "hang") searchPatterns.unshift("hung");
                if (rawWord === "swing") searchPatterns.unshift("swung");
                if (rawWord === "think of") searchPatterns.unshift("thought of");
                if (rawWord === "pull out") searchPatterns.unshift("pulled out");
                if (rawWord === "sign up for") searchPatterns.unshift("signed up for");
                if (rawWord === "take off") searchPatterns.unshift("took off");
                if (rawWord === "come up with") searchPatterns.unshift("came up with");
                if (rawWord === "break down") searchPatterns.unshift("broke down");
                if (rawWord === "let out") searchPatterns.unshift("letting out");
                if (rawWord === "disappear") searchPatterns.unshift("disappeared");
                if (rawWord === "introduce") searchPatterns.unshift("introduced");
                if (rawWord === "accept") searchPatterns.unshift("accepted");
                if (rawWord === "continue") searchPatterns.unshift("continued");
                if (rawWord === "serve") searchPatterns.unshift("serves", "served");
                if (rawWord === "reach") searchPatterns.unshift("reached");
                if (rawWord === "form") searchPatterns.unshift("forms", "formed");
            }

            let result = sentence;
            let matched = false;

            for (const pat of searchPatterns) {
                // 避免重複替換 HTML 標籤
                const regex = new RegExp(`(${pat}(?:s|es|ed|ing)?)`, "i");
                if (regex.test(result)) {
                    result = result.replace(regex, (match) => {
                        if (isClozeMode) {
                            return `<span class="inline-block px-3 py-0.5 mx-1 border-b-2 border-indigo-600 text-indigo-700 font-black bg-indigo-50/90 rounded">________</span>`;
                        } else {
                            return `<strong class="px-1.5 py-0.5 rounded bg-indigo-100/90 text-indigo-800 font-extrabold border-b-2 border-indigo-400">${match}</strong>`;
                        }
                    });
                    matched = true;
                    break;
                }
            }

            // 防呆保證：若未能精準比對到字尾變化，在填空模式下於句末補上提示空格，絕不回傳空白
            if (!matched && isClozeMode) {
                result += ` <span class="inline-block px-3 py-0.5 mx-1 border-b-2 border-indigo-600 text-indigo-700 font-black bg-indigo-50/90 rounded">[ ________ ]</span>`;
            }

            return result;
        };

