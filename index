        // ==========================================
        // 測驗挑戰區邏輯 (Quiz Arena)
        // ==========================================
        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        window.startQuiz = function() {
            if (!validateStep1Profile()) return;

            const pool = getSelectedVocabList();
            if (pool.length === 0) {
                showToast("請至少選擇一個有效的課程單元！", "error");
                return;
            }

            // 徹底隨機打亂題目順序
            let shuffledPool = shuffleArray(pool);
            if (appState.questionCount === 10 && shuffledPool.length > 10) {
                shuffledPool = shuffledPool.slice(0, 10);
            }

            const modes = ["cloze", "en2zh", "zh2en"];

            // 為每一題建立題型與徹底隨機打亂的 A, B, C, D 選項
            appState.quizQuestions = shuffledPool.map((item) => {
                const mode = appState.questionType === "mixed"
                    ? modes[Math.floor(Math.random() * modes.length)]
                    : appState.questionType;

                // 從全庫挑選 3 個干擾項
                const distractorsPool = shuffleArray(VOCAB_DATA.filter(v => v.word !== item.word));
                const distractors = distractorsPool.slice(0, 3);

                let rawOptions = [];
                let correctAnswerText = "";
                let promptHtml = "";
                let subHint = "";
                let speakTarget = item.word;
                let categoryLabel = "";

                if (mode === "cloze") {
                    categoryLabel = "例句填空測驗";
                    promptHtml = window.highlightBlank(item.example, item.word, true);
                    subHint = `中文提示：${item.exampleZh}`;
                    speakTarget = item.example;
                    correctAnswerText = item.word;
                    rawOptions = [item.word, ...distractors.map(d => d.word)];
                } else if (mode === "en2zh") {
                    categoryLabel = "英翻中測驗";
                    promptHtml = `<span class="text-2xl sm:text-3xl font-black text-indigo-700">${item.word}</span>`;
                    subHint = "請選出最符合此英文單字或片語的中文解釋：";
                    speakTarget = item.word;
                    correctAnswerText = item.zh;
                    rawOptions = [item.zh, ...distractors.map(d => d.zh)];
                } else {
                    categoryLabel = "中翻英測驗";
                    promptHtml = `<span class="text-2xl sm:text-3xl font-black text-purple-700">${item.zh}</span>`;
                    subHint = "請選出對應的英文單字或片語：";
                    speakTarget = item.word;
                    correctAnswerText = item.word;
                    rawOptions = [item.word, ...distractors.map(d => d.word)];
                }

                // 徹底打亂選項陣列
                const shuffledOptions = shuffleArray(rawOptions);

                return {
                    vocab: item,
                    mode,
                    categoryLabel,
                    promptHtml,
                    subHint,
                    speakTarget,
                    correctAnswerText,
                    options: shuffledOptions
                };
            });

            appState.currentIndex = 0;
            appState.correctCount = 0;
            appState.score = 0;
            appState.wrongList = [];
            appState.answeredCurrent = false;

            const preset = UNIT_PRESETS.find(p => p.id === appState.selectedPresetId) || UNIT_PRESETS[0];
            const typeNames = { mixed: "混合題型", cloze: "例句填空", en2zh: "英翻中", zh2en: "中翻英" };
            document.getElementById("quizUnitBadge").textContent = preset.label;
            document.getElementById("quizTypeBadge").textContent = typeNames[appState.questionType] || "混合題型";
            document.getElementById("quizTotalNum").textContent = appState.quizQuestions.length;

            switchView("view-quiz");
            renderCurrentQuestion();
        };

        function renderCurrentQuestion() {
            const q = appState.quizQuestions[appState.currentIndex];
            const total = appState.quizQuestions.length;
            appState.answeredCurrent = false;

            document.getElementById("quizCurrentNum").textContent = appState.currentIndex + 1;
            const percent = Math.round(((appState.currentIndex + 1) / total) * 100);
            document.getElementById("quizProgressBar").style.width = `${percent}%`;

            document.getElementById("questionCategoryLabel").textContent = q.categoryLabel;
            document.getElementById("questionPromptText").innerHTML = q.promptHtml;
            document.getElementById("questionSubHint").textContent = q.subHint;

            // 隱藏回饋區與下一題按鈕
            const feedbackBox = document.getElementById("quizFeedbackBox");
            feedbackBox.classList.add("hidden");
            const nextBtn = document.getElementById("nextQuestionBtn");
            nextBtn.classList.add("hidden");
            document.getElementById("nextQuestionBtnText").textContent =
                appState.currentIndex === total - 1 ? "查看結算成績" : "下一題";

            const letters = ["A", "B", "C", "D"];
            const optionsContainer = document.getElementById("quizOptionsContainer");
            optionsContainer.innerHTML = q.options.map((optText, idx) => {
                const escapedOpt = optText.replace(/'/g, "\\'").replace(/"/g, "&quot;");
                return `
                <button type="button" id="optBtn_${idx}" onclick="window.selectQuizOption(${idx})"
                    class="w-full text-left p-4 rounded-2xl bg-white/90 hover:bg-indigo-50/90 border-2 border-slate-200 hover:border-indigo-400 transition flex items-center gap-3.5 group shadow-sm">
                    <span class="w-9 h-9 rounded-xl bg-slate-100 group-hover:bg-indigo-600 group-hover:text-white text-slate-700 font-black flex items-center justify-center shrink-0 transition">
                        ${letters[idx]}
                    </span>
                    <span class="text-base sm:text-lg font-bold text-slate-800">${optText}</span>
                </button>
                `;
            }).join("");

            // 若為英翻中，自動朗讀單字輔助聽力
            if (q.mode === "en2zh") {
                window.speakText(q.speakTarget);
            }
        }

        window.speakCurrentQuestion = function() {
            const q = appState.quizQuestions[appState.currentIndex];
            if (q) window.speakText(q.speakTarget);
        };

        window.selectQuizOption = function(selectedIndex) {
            if (appState.answeredCurrent) return;
            appState.answeredCurrent = true;

            const q = appState.quizQuestions[appState.currentIndex];
            const chosenText = q.options[selectedIndex];
            const isCorrect = chosenText === q.correctAnswerText;

            if (isCorrect) {
                appState.correctCount++;
                playSoundEffect("correct");
            } else {
                playSoundEffect("wrong");
                appState.wrongList.push({
                    word: q.vocab.word,
                    zh: q.vocab.zh,
                    userAnswer: chosenText,
                    correctAnswer: q.correctAnswerText,
                    example: q.vocab.example,
                    exampleZh: q.vocab.exampleZh
                });
            }

            // 鎖定所有按鈕並標示正誤顏色
            q.options.forEach((optText, idx) => {
                const btn = document.getElementById(`optBtn_${idx}`);
                btn.disabled = true;
                btn.classList.remove("hover:bg-indigo-50/90", "hover:border-indigo-400");

                if (appState.instantFeedback) {
                    if (optText === q.correctAnswerText) {
                        btn.classList.remove("bg-white/90", "border-slate-200");
                        btn.classList.add("bg-emerald-50", "border-emerald-500", "ring-2", "ring-emerald-500/20");
                        btn.querySelector("span:first-child").className = "w-9 h-9 rounded-xl bg-emerald-500 text-white font-black flex items-center justify-center shrink-0";
                    } else if (idx === selectedIndex && !isCorrect) {
                        btn.classList.remove("bg-white/90", "border-slate-200");
                        btn.classList.add("bg-rose-50", "border-rose-500");
                        btn.querySelector("span:first-child").className = "w-9 h-9 rounded-xl bg-rose-500 text-white font-black flex items-center justify-center shrink-0";
                    }
                } else if (idx === selectedIndex) {
                    btn.classList.add("bg-indigo-50", "border-indigo-500");
                }
            });

            // 顯示即時解析回饋 (若開啟即時顯示答案，或答錯時強制顯示解析以利學習)
            const feedbackBox = document.getElementById("quizFeedbackBox");
            const feedbackIcon = document.getElementById("feedbackIcon");
            const feedbackTitle = document.getElementById("feedbackTitle");
            const feedbackAnswerText = document.getElementById("feedbackAnswerText");
            const feedbackExampleText = document.getElementById("feedbackExampleText");

            if (appState.instantFeedback) {
                feedbackBox.classList.remove("hidden", "bg-emerald-50/90", "border-emerald-300", "bg-rose-50/90", "border-rose-300");
                if (isCorrect) {
                    feedbackBox.classList.add("bg-emerald-50/90", "border-emerald-300");
                    feedbackIcon.className = "w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center shrink-0 mt-0.5 text-white";
                    feedbackIcon.innerHTML = `<i class="fa-solid fa-check"></i>`;
                    feedbackTitle.textContent = "太棒了！回答正確！";
                    feedbackTitle.className = "font-extrabold text-base text-emerald-800";
                } else {
                    feedbackBox.classList.add("bg-rose-50/90", "border-rose-300");
                    feedbackIcon.className = "w-8 h-8 rounded-full bg-rose-500 flex items-center justify-center shrink-0 mt-0.5 text-white";
                    feedbackIcon.innerHTML = `<i class="fa-solid fa-xmark"></i>`;
                    feedbackTitle.textContent = "哎呀，答錯囉！請看正確解析：";
                    feedbackTitle.className = "font-extrabold text-base text-rose-800";
                }
                feedbackAnswerText.innerHTML = `正確答案：<span class="underline">${q.correctAnswerText}</span>（${q.vocab.word}：${q.vocab.zh}）`;
                feedbackExampleText.innerHTML = `例句：${window.highlightBlank(q.vocab.example, q.vocab.word, false)}<br><span class="text-slate-500">${q.vocab.exampleZh}</span>`;
            }

            // 朗讀單字強化記憶
            window.speakText(q.vocab.word);

            // 顯示下一題按鈕
            document.getElementById("nextQuestionBtn").classList.remove("hidden");
        };

