        async function writeScoreWithRetry(payload, maxRetries = 2) {
            if (!db || !scoresColRef) {
                throw new Error("Firestore 尚未就緒");
            }

            for (let attempt = 0; attempt <= maxRetries; attempt++) {
                try {
                    // 確保已通過 Firebase 驗證
                    if (!auth.currentUser) {
                        await signInAnonymously(auth);
                        appState.isAuthReady = true;
                    }
                    const docRef = await addDoc(scoresColRef, {
                        ...payload,
                        uid: auth.currentUser?.uid || "anonymous",
                        syncedAt: new Date().toISOString()
                    });
                    return docRef.id;
                } catch (err) {
                    if (attempt === maxRetries) {
                        throw err;
                    }
                    // 嘗試重新匿名驗證並等待短暫延遲後重試
                    try {
                        await signInAnonymously(auth);
                    } catch (_) {}
                    await new Promise(res => setTimeout(res, 800 * (attempt + 1)));
                }
            }
        }

