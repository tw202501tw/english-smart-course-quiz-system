                try {
                    window.localStorage.setItem(key, value);
                } catch (err) {
                    memoryFallbackStorage[key] = String(value);
                }
            },
            removeItem(key) {
                try {
                    window.localStorage.removeItem(key);
                } catch (err) {
                    delete memoryFallbackStorage[key];
