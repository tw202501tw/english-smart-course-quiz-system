<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>未來視窗 - 115學年度 11月 英語單字學習與測驗系統</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Canvas Confetti for 100-score Celebration -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.72);
            --glass-border: rgba(255, 255, 255, 0.55);
            --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.12);
        }

        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 35%, #dbeafe 70%, #fae8ff 100%);
            background-attachment: fixed;
            min-height: 100vh;
            color: #1e293b;
            overflow-x: hidden;
        }

        /* 動態背景光暈 */
        .bg-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            opacity: 0.6;
            animation: floatOrb 12s infinite alternate ease-in-out;
        }
        .orb-1 { width: 380px; height: 380px; background: #818cf8; top: -80px; left: -80px; }
        .orb-2 { width: 420px; height: 420px; background: #c084fc; bottom: -100px; right: -80px; animation-delay: -4s; }
        .orb-3 { width: 300px; height: 300px; background: #38bdf8; top: 45%; left: 55%; animation-delay: -8s; }

        @keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(30px, -40px) scale(1.08); }
        }

        /* Glassmorphism 核心樣式 */
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(79, 70, 229, 0.14);
            border-color: rgba(99, 102, 241, 0.4);
        }

        /* 選取亮起效果 */
        .option-pill {
            transition: all 0.2s ease;
            border: 2px solid rgba(203, 213, 225, 0.8);
            background: rgba(255, 255, 255, 0.7);
        }
        .option-pill:hover {
            border-color: #818cf8;
            background: rgba(238, 242, 255, 0.9);
        }
        .option-pill.active {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: #ffffff;
            border-color: #4f46e5;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);
            transform: scale(1.03);
            font-weight: 700;
        }

        /* 金色榮譽卡片 (100分專屬) */
        .gold-honor-card {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 45%, #fde68a 100%);
            border: 2px solid #f59e0b;
            box-shadow: 0 15px 40px rgba(245, 158, 11, 0.35), inset 0 0 20px rgba(255, 255, 255, 0.8);
            position: relative;
            overflow: hidden;
        }
        .gold-honor-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.65), transparent);
            transform: rotate(30deg);
            animation: shineSweep 3.5s infinite;
        }
        @keyframes shineSweep {
            0% { transform: translateX(-100%) rotate(30deg); }
            100% { transform: translateX(100%) rotate(30deg); }
        }

        /* 自訂捲軸 */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(255,255,255,0.3); border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.4); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(79, 70, 229, 0.7); }

        /* 切換開關動畫 */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #4f46e5;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #4f46e5;
        }
    </style>
</head>
<body class="antialiased selection:bg-indigo-500 selection:text-white">
    <!-- 背景動態光暈 -->
    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="bg-orb orb-3"></div>

    <!-- 頂部導覽列 -->
    <header class="sticky top-0 z-40 glass-panel border-b border-white/60 px-4 py-3">
        <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3 cursor-pointer" onclick="window.goHome()">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-700 via-purple-700 to-pink-600 tracking-tight">
                        未來視窗 <span class="text-xs sm:text-sm font-bold px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 ml-1">115-11月</span>
                    </h1>
                    <p class="text-[11px] text-slate-500 font-medium hidden sm:block">智慧雙語學習與雲端測驗系統</p>
                </div>
            </div>

            <!-- 狀態與功能按鈕 -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- 雲端連線與待補傳指示燈 -->
                <div id="cloudStatusBadge" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-white/80 border border-slate-200 text-slate-600 shadow-sm">
                    <span id="cloudDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    <span id="cloudStatusText">雲端連線中...</span>
                </div>

                <!-- 學生資訊徽章 (登入後顯示) -->
                <div id="studentHeaderBadge" class="hidden items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50/90 border border-indigo-200 text-indigo-800 text-xs font-bold">
                    <i class="fa-solid fa-user-graduate text-indigo-600"></i>
                    <span id="headerStudentInfo"></span>
                </div>

                <!-- 教師後台入口按鈕 -->
                <button onclick="window.openTeacherModal()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs sm:text-sm font-semibold shadow-md transition flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-halved text-amber-400"></i>
                    <span>教師後台</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 全域提示訊息 Toast -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- 主內容區 -->
    <main class="max-w-6xl mx-auto px-4 py-6 sm:py-8">

        <!-- ========================================== -->
        <!-- 畫面 1：兩階段入口與選課流程 (Step 1 & 2) -->
        <!-- ========================================== -->
        <section id="view-setup" class="space-y-6">
            <!-- 歡迎橫幅 -->
            <div class="glass-panel rounded-3xl p-6 sm:p-8 text-center relative overflow-hidden">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-100/80 text-indigo-700 text-xs font-bold mb-3">
                    <i class="fa-solid fa-sparkles"></i> 115學年度 11月 最新單字題庫 (U1 ~ U12)
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-800 mb-2">歡迎來到「未來視窗」英語學習殿堂</h2>
                <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">請先完成下方兩階段個人資料與課程設定，即可進入「單字學習館」預習發音，或直接挑戰「隨機測驗」！</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- STEP 1: 個人資料 -->
                <div class="lg:col-span-5 glass-panel rounded-3xl p-6 sm:p-7 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-5">
                            <span class="w-8 h-8 rounded-full bg-indigo-600 text-white font-black flex items-center justify-center text-sm shadow-md">1</span>
                            <h3 class="text-xl font-extrabold text-slate-800">Step 1 個人資料</h3>
                        </div>

                        <div class="space-y-4">
                            <!-- 學生姓名 -->
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1.5">
                                    <i class="fa-solid fa-signature text-indigo-500 mr-1"></i> 學生姓名 <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" id="studentNameInput" placeholder="請輸入您的真實姓名（例如：王小明）"
                                    class="w-full px-4 py-3 rounded-2xl bg-white/90 border-2 border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition font-medium text-slate-800">
                            </div>

                            <!-- ① 學歷下拉選單 -->
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1.5">
                                    <i class="fa-solid fa-school text-indigo-500 mr-1"></i> ① 學歷 / 階段 <span class="text-rose-500">*</span>
                                </label>
                                <select id="educationSelect" onchange="window.handleEducationChange()"
                                    class="w-full px-4 py-3 rounded-2xl bg-white/90 border-2 border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition font-semibold text-slate-800 cursor-pointer">
                                    <option value="">-- 請選擇學歷 --</option>
                                    <option value="幼稚園">幼稚園</option>
                                    <option value="國小">國小</option>
                                    <option value="國中">國中</option>
                                    <option value="高中">高中</option>
                                    <option value="大學">大學</option>
                                    <option value="大學畢業(不是老師)">大學畢業(不是老師)</option>
                                    <option value="老師">老師</option>
                                </select>
                            </div>

                            <!-- ② 年級/身分動態連動選單 -->
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1.5">
                                    <i class="fa-solid fa-layer-group text-purple-500 mr-1"></i> ② 年級 / 身分 <span class="text-rose-500">*</span>
                                </label>
                                <select id="gradeSelect" disabled
                                    class="w-full px-4 py-3 rounded-2xl bg-white/90 border-2 border-slate-200 focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition font-semibold text-slate-800 disabled:bg-slate-100/70 disabled:text-slate-400 cursor-pointer">
                                    <option value="">-- 請先選擇上方學歷 --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 p-3.5 rounded-2xl bg-indigo-50/80 border border-indigo-100 text-xs text-indigo-800 flex items-start gap-2.5">
                        <i class="fa-solid fa-circle-info text-indigo-500 mt-0.5 text-sm"></i>
                        <span>系統會自動記憶您輸入的姓名與年級，方便下次快速登入與學習。</span>
                    </div>
                </div>

                <!-- STEP 2: 課程與模式選擇 -->
                <div class="lg:col-span-7 glass-panel rounded-3xl p-6 sm:p-7 space-y-6">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-purple-600 text-white font-black flex items-center justify-center text-sm shadow-md">2</span>
                            <h3 class="text-xl font-extrabold text-slate-800">Step 2 課程與模式選擇</h3>
                        </div>
                        <span id="selectedVocabCountBadge" class="px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-xs font-extrabold">
                            已選範圍：0 個單字
                        </span>
                    </div>

                    <!-- 課程/單元選擇按鈕 -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fa-solid fa-book-open text-purple-500 mr-1"></i> 選擇單元範圍
                        </label>
                        <div id="unitButtonsContainer" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-2">
                            <!-- 由 JS 動態生成單元按鈕 -->
                        </div>
                    </div>

                    <!-- 題數與題型選擇 -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <!-- 題數選擇 -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fa-solid fa-list-ol text-indigo-500 mr-1"></i> 測驗題數
                            </label>
                            <div class="grid grid-cols-2 gap-2.5">
                                <button type="button" id="btnCount10" onclick="window.setQuestionCount(10)"
                                    class="option-pill active py-2.5 px-4 rounded-xl text-sm font-semibold text-center">
                                    10 題
                                </button>
                                <button type="button" id="btnCountAll" onclick="window.setQuestionCount('all')"
                                    class="option-pill py-2.5 px-4 rounded-xl text-sm font-semibold text-center">
                                    全部題目
                                </button>
                            </div>
                        </div>

                        <!-- 即時顯示答案切換開關 -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fa-solid fa-bolt text-amber-500 mr-1"></i> 作答輔助設定
                            </label>
                            <label class="flex items-center justify-between p-2.5 px-4 rounded-xl bg-white/80 border-2 border-slate-200 cursor-pointer hover:border-indigo-300 transition">
                                <span class="text-sm font-bold text-slate-700">即時顯示答案與解析</span>
                                <div class="relative inline-block w-11 h-6 align-middle select-none">
                                    <input type="checkbox" id="instantFeedbackToggle" checked onchange="window.toggleInstantFeedback(this.checked)"
                                        class="sr-only peer">
                                    <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- 題型選擇 -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fa-solid fa-shapes text-pink-500 mr-1"></i> 測驗題型模式
                        </label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <button type="button" id="btnTypeMixed" onclick="window.setQuestionType('mixed')"
                                class="option-pill active py-2.5 px-3 rounded-xl text-sm font-semibold text-center">
                                <i class="fa-solid fa-shuffle mr-1"></i> 混合題型
                            </button>
                            <button type="button" id="btnTypeCloze" onclick="window.setQuestionType('cloze')"
                                class="option-pill py-2.5 px-3 rounded-xl text-sm font-semibold text-center">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> 例句填空
                            </button>
                            <button type="button" id="btnTypeEnToZh" onclick="window.setQuestionType('en2zh')"
                                class="option-pill py-2.5 px-3 rounded-xl text-sm font-semibold text-center">
                                <i class="fa-solid fa-language mr-1"></i> 英翻中
                            </button>
                            <button type="button" id="btnTypeZhToEn" onclick="window.setQuestionType('zh2en')"
                                class="option-pill py-2.5 px-3 rounded-xl text-sm font-semibold text-center">
                                <i class="fa-solid fa-earth-americas mr-1"></i> 中翻英
                            </button>
                        </div>
                    </div>

                    <!-- 行動按鈕區 -->
                    <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <button type="button" onclick="window.enterStudyHall()"
                            class="py-3.5 px-6 rounded-2xl bg-white hover:bg-indigo-50 text-indigo-700 border-2 border-indigo-200 font-extrabold text-base shadow-sm hover:shadow transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open-reader text-lg"></i>
                            <span>進入單字學習館</span>
                        </button>
                        <button type="button" onclick="window.startQuiz()"
                            class="py-3.5 px-6 rounded-2xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-700 hover:to-pink-700 text-white font-extrabold text-base shadow-lg shadow-indigo-500/30 hover:shadow-xl transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rocket text-lg"></i>
                            <span>開始測驗挑戰</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 畫面 2：單字學習館 (Vocabulary Study Hall) -->
        <!-- ========================================== -->
        <section id="view-study" class="hidden space-y-6">
            <div class="glass-panel rounded-3xl p-5 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-3 py-1 rounded-full bg-indigo-600 text-white text-xs font-bold" id="studyUnitTitle">U1</span>
                        <h2 class="text-xl sm:text-2xl font-black text-slate-800">單字學習館</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">點擊喇叭圖示聆聽標準英語發音，例句已自動高亮目標單字。</p>
                </div>

                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <!-- 關鍵字搜尋 -->
                    <div class="relative flex-1 md:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="studySearchInput" oninput="window.filterStudyCards()" placeholder="搜尋英文或中文解釋..."
                            class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-white/90 border border-slate-200 focus:border-indigo-500 outline-none text-sm font-medium">
                    </div>

                    <button onclick="window.goHome()" class="px-4 py-2.5 rounded-xl bg-white/90 hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-bold transition">
                        <i class="fa-solid fa-arrow-left mr-1"></i> 重選單元
                    </button>
                    <button onclick="window.startQuiz()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-bold shadow-md hover:shadow-lg transition">
                        <i class="fa-solid fa-play mr-1"></i> 立即測驗
                    </button>
                </div>
            </div>

            <!-- 單字卡片網格 -->
            <div id="studyCardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- 由 JS 動態渲染 -->
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 畫面 3：測驗挑戰區 (Quiz Arena)            -->
        <!-- ========================================== -->
        <section id="view-quiz" class="hidden max-w-3xl mx-auto space-y-6">
            <!-- 頂部進度條與計分資訊 -->
            <div class="glass-panel rounded-3xl p-5">
                <div class="flex items-center justify-between text-sm font-bold text-slate-700 mb-2">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-lg bg-indigo-100 text-indigo-700 text-xs font-extrabold" id="quizUnitBadge">U1</span>
                        <span id="quizTypeBadge" class="px-2.5 py-0.5 rounded-lg bg-purple-100 text-purple-700 text-xs font-extrabold">混合題型</span>
                    </div>
                    <div>
                        第 <span id="quizCurrentNum" class="text-indigo-600 text-lg font-black">1</span> / <span id="quizTotalNum">10</span> 題
                    </div>
                </div>
                <div class="w-full h-3 bg-slate-200/80 rounded-full overflow-hidden">
                    <div id="quizProgressBar" class="h-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 transition-all duration-300 rounded-full" style="width: 10%"></div>
                </div>
            </div>

            <!-- 題目卡片 -->
            <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-6">
                <div class="flex items-start justify-between gap-4">
                    <div class="space-y-2 flex-1">
                        <span id="questionCategoryLabel" class="inline-block text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
                            例句填空
                        </span>
                        <h3 id="questionPromptText" class="text-xl sm:text-2xl font-extrabold text-slate-800 leading-relaxed">
                            題目載入中...
                        </h3>
                        <p id="questionSubHint" class="text-sm text-slate-500 font-medium"></p>
                    </div>
