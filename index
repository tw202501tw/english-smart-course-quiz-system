        // RULE 5 & RULE 6: 雙通道密碼修改 (同步寫入 Firestore 與 safeStorage，含驗證重試)
        window.submitChangePassword = async function() {
            const newPwd = document.getElementById("newPasswordInput").value.trim();
            const confirmPwd = document.getElementById("confirmNewPasswordInput").value.trim();
            const msgEl = document.getElementById("changePwdStatusMsg");

            if (newPwd.length < 4) {
                msgEl.textContent = "新密碼長度至少需要 4 個字元！";
                msgEl.className = "text-xs font-bold text-rose-500 block";
                return;
            }
            if (newPwd !== confirmPwd) {
                msgEl.textContent = "兩次輸入的密碼不一致，請重新確認！";
                msgEl.className = "text-xs font-bold text-rose-500 block";
                return;
            }

            // 通道 1：立即寫入本機 safeStorage
            appState.teacherPassword = newPwd;
            safeStorage.setItem("fw_teacher_pwd", newPwd);
            safeStorage.setItem("fw_teacher_pwd_changed", "true");

            msgEl.textContent = "正在同步更新雲端密碼...";
            msgEl.className = "text-xs font-bold text-indigo-600 block";

            // 通道 2：寫入 Firestore 雲端設定 (含自動重連重試)
            try {
                if (db && teacherConfigDocRef) {
                    if (!auth.currentUser) {
                        await signInAnonymously(auth);
                    }
                    await setDoc(teacherConfigDocRef, {
                        password: newPwd,
                        updatedAt: new Date().toISOString()
                    }, { merge: true });
                }
                closeModal("changePasswordModal");
                showToast("後台密碼已透過雙通道更新並同步至雲端！🔐", "success");
            } catch (err) {
                closeModal("changePasswordModal");
                showToast("本機密碼已更新，但雲端同步延遲，將於連線正常時自動套用。", "warning");
            }
        };

        // RULE 3: 所有篩選與排序皆在前端 JS 內存完成
        window.renderTeacherTable = function() {
            const searchKw = (document.getElementById("adminSearchInput")?.value || "").trim().toLowerCase();
            const filterEdu = document.getElementById("adminFilterEdu")?.value || "ALL";
            const sortMode = document.getElementById("adminSortSelect")?.value || "time_desc";

            // 合併雲端紀錄與尚未補傳的本機暫存紀錄，確保教師視角完整不漏接
            const pendingRaw = safeStorage.getItem("fw_pending_scores");
            let pendingList = [];
            try { pendingList = pendingRaw ? JSON.parse(pendingRaw) : []; } catch (_) {}

            const combined = [
                ...appState.cloudScores.map(s => ({ ...s, isPending: false })),
                ...pendingList.map(p => ({ ...p, id: p.localId, isPending: true }))
            ];

            // 內存篩選
            const filtered = combined.filter(rec => {
                const matchName = !searchKw || (rec.studentName || "").toLowerCase().includes(searchKw);
                const matchEdu = filterEdu === "ALL" || rec.education === filterEdu;
                return matchName && matchEdu;
            });

            // 內存排序
            filtered.sort((a, b) => {
                const tA = Number(a.timestamp) || 0;
                const tB = Number(b.timestamp) || 0;
                const sA = Number(a.score) || 0;
                const sB = Number(b.score) || 0;

                if (sortMode === "time_desc") return tB - tA;
                if (sortMode === "time_asc") return tA - tB;
                if (sortMode === "score_desc") return sB - sA;
                if (sortMode === "score_asc") return sA - sB;
                return tB - tA;
            });

            // 更新頂部統計卡片
            document.getElementById("statTotalRecords").textContent = filtered.length;
            const avg = filtered.length > 0
                ? Math.round(filtered.reduce((acc, cur) => acc + (Number(cur.score) || 0), 0) / filtered.length)
                : 0;
            document.getElementById("statAvgScore").textContent = avg;
            const perfect = filtered.filter(r => Number(r.score) === 100).length;
            document.getElementById("statPerfectCount").textContent = perfect;

            const tbody = document.getElementById("teacherScoresTableBody");
            if (!tbody) return;

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 text-center text-slate-400 font-bold">
                            目前沒有符合條件的學生作答紀錄
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map(rec => {
                const is100 = Number(rec.score) === 100;
                const scoreBadge = is100
                    ? `<span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 font-black border border-amber-300"><i class="fa-solid fa-crown mr-1"></i>100 分</span>`
                    : `<span class="font-extrabold ${Number(rec.score) >= 60 ? 'text-indigo-600' : 'text-rose-600'}">${rec.score} 分</span>`;

                const pendingTag = rec.isPending
                    ? `<span class="ml-1.5 px-2 py-0.5 rounded bg-amber-100 text-amber-700 text-[10px] font-bold">待補傳</span>`
                    : "";

                return `
                <tr class="hover:bg-indigo-50/40 transition">
                    <td class="py-3.5 px-4 font-extrabold text-slate-800">${rec.studentName || "未具名"}${pendingTag}</td>
                    <td class="py-3.5 px-4 text-slate-600 font-medium">${rec.education || "-"}・${rec.grade || "-"}</td>
                    <td class="py-3.5 px-4"><span class="px-2.5 py-0.5 rounded-lg bg-indigo-50 text-indigo-700 font-bold text-xs">${rec.unit || "-"}</span></td>
                    <td class="py-3.5 px-4 text-xs text-slate-500 font-semibold">${rec.questionType || "-"} (${rec.correctCount || 0}/${rec.totalQuestions || 0})</td>
                    <td class="py-3.5 px-4">${scoreBadge}</td>
                    <td class="py-3.5 px-4 text-xs text-slate-500">${rec.dateStr || "-"}</td>
                    <td class="py-3.5 px-4 text-center">
                        <button onclick="window.deleteSingleScore('${rec.id}', ${Boolean(rec.isPending)})"
                            class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white text-xs font-bold transition" title="刪除此筆紀錄">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                `;
            }).join("");
        };

        window.deleteSingleScore = function(docId, isPending) {
            openConfirmModal(
                "刪除單筆作答紀錄",
                "確定要永久刪除此筆學生成績嗎？刪除後將無法復原。",
                async () => {
                    closeModal("customConfirmModal");
                    try {
                        if (isPending) {
                            const raw = safeStorage.getItem("fw_pending_scores");
                            let q = raw ? JSON.parse(raw) : [];
                            q = q.filter(item => item.localId !== docId);
                            safeStorage.setItem("fw_pending_scores", JSON.stringify(q));
                            updatePendingBadgeCount();
                            window.renderTeacherTable();
                        } else if (db) {
                            await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'scores', docId));
                        }
                        showToast("已成功刪除該筆成績紀錄。", "success");
                    } catch (err) {
                        showToast("刪除失敗，請確認網路連線後再試。", "error");
                    }
                }
            );
        };

        window.confirmClearAllScores = function() {
            openConfirmModal(
                "⚠️ 一鍵清空所有成績",
                "此操作將會刪除雲端與本機的所有學生作答紀錄！您確定要全部清空嗎？",
                async () => {
                    closeModal("customConfirmModal");
                    try {
                        // 清空本機待補傳
                        safeStorage.removeItem("fw_pending_scores");
                        updatePendingBadgeCount();

                        // 逐筆刪除雲端集合文件
                        if (db && appState.cloudScores.length > 0) {
                            const deletePromises = appState.cloudScores.map(rec =>
                                deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'scores', rec.id))
                            );
                            await Promise.all(deletePromises);
                        }
                        window.renderTeacherTable();
                        showToast("已清空所有學生作答紀錄！", "success");
                    } catch (err) {
                        showToast("清空過程發生部分錯誤，請稍後再試。", "error");
                    }
                }
            );
        };

        // 匯出 UTF-8 BOM Excel (CSV)
        window.exportScoresCSV = function() {
            const headers = ["學生姓名", "學歷", "年級/身分", "測驗單元", "測驗題型", "答對題數", "總題數", "總得分", "作答時間"];
            const rows = appState.cloudScores.map(r => [
                `"${(r.studentName || "").replace(/"/g, '""')}"`,
                `"${(r.education || "").replace(/"/g, '""')}"`,
                `"${(r.grade || "").replace(/"/g, '""')}"`,
                `"${(r.unit || "").replace(/"/g, '""')}"`,
                `"${(r.questionType || "").replace(/"/g, '""')}"`,
                r.correctCount || 0,
                r.totalQuestions || 0,
                r.score || 0,
                `"${(r.dateStr || "").replace(/"/g, '""')}"`
            ]);

            // 加入 \uFEFF UTF-8 BOM 確保 Excel 開啟中文絕不亂碼
            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            const dateTag = new Date().toISOString().slice(0, 10);
            link.setAttribute("href", url);
            link.setAttribute("download", `未來視窗_115-11月_學生成績冊_${dateTag}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
            showToast("已成功匯出 UTF-8 BOM Excel (CSV) 檔案！", "success");
        };

        // ==========================================
        // Modal 與 Toast 互動通知工具
        // ==========================================
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) {
                el.classList.remove("hidden");
                el.classList.add("flex");
            }
        }
        window.closeModal = function(id) {
            const el = document.getElementById(id);
            if (el) {
                el.classList.add("hidden");
                el.classList.remove("flex");
            }
        };

        function openConfirmModal(title, message, onConfirm) {
            document.getElementById("confirmModalTitle").textContent = title;
            document.getElementById("confirmModalMessage").textContent = message;
            const actionBtn = document.getElementById("confirmModalActionBtn");
            actionBtn.onclick = onConfirm;
            openModal("customConfirmModal");
        }

        function showToast(message, type = "info") {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");

            const styles = {
                success: "bg-emerald-600 text-white border-emerald-400",
                error: "bg-rose-600 text-white border-rose-400",
                warning: "bg-amber-500 text-white border-amber-300",
                info: "bg-slate-800 text-white border-slate-600"
            };
            const icons = {
                success: "fa-circle-check",
                error: "fa-circle-exclamation",
                warning: "fa-triangle-exclamation",
                info: "fa-circle-info"
            };

            toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${styles[type] || styles.info}`;
            toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info} text-base"></i><span>${message}</span>`;

            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove("translate-y-2", "opacity-0");
            });

            setTimeout(() => {
                toast.classList.add("opacity-0", "translate-y-2");
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // ==========================================
        // 啟動應用程式
        // ==========================================
        window.addEventListener("DOMContentLoaded", () => {
            initSetupUI();
            initFirebaseSafely();
        });
    </script>
</body>
</html>
