        window.syncPendingScores = async function(silent = false) {
            const raw = safeStorage.getItem("fw_pending_scores");
            let queue = [];
            try { queue = raw ? JSON.parse(raw) : []; } catch (_) { queue = []; }
            updatePendingBadgeCount();

            if (queue.length === 0) {
                if (!silent) showToast("目前沒有待補傳的離線成績紀錄。", "info");
                return;
            }

            if (!navigator.onLine || !db) {
                if (!silent) showToast("目前處於離線狀態，將於恢復連線時自動補傳。", "warning");
                return;
            }

            updateCloudBadge("syncing", `補傳中 (${queue.length})...`);
            const remaining = [];
            let successCount = 0;

            for (const item of queue) {
                try {
                    await writeScoreWithRetry(item, 1);
                    successCount++;
                } catch (err) {
                    remaining.push(item);
                }
            }

            safeStorage.setItem("fw_pending_scores", JSON.stringify(remaining));
            updatePendingBadgeCount();

            if (remaining.length === 0) {
                updateCloudBadge("online", "雲端已連線");
                if (successCount > 0) {
                    showToast(`已自動將 ${successCount} 筆離線暫存成績補傳至雲端！☁️`, "success");
                }
            } else {
                updateCloudBadge("offline", `待補傳 (${remaining.length})`);
            }
        };

