        // 音效與語音合成引擎 (Web Audio & Web Speech)
        // ==========================================
        let audioCtx = null;
        function playSoundEffect(type) {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === "suspended") {
                    audioCtx.resume();
                }

                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === "correct") {
                    // 清脆悅耳雙音
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(587.33, now); // D5
                    osc.frequency.setValueAtTime(880, now + 0.1); // A5
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else if (type === "wrong") {
                    // 低沉提示音
                    osc.type = "triangle";
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.linearRampToValueAtTime(165, now + 0.25);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === "fanfare") {
                    // 100分勝利號角和弦
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.type = "triangle";
                        o.frequency.setValueAtTime(freq, now + idx * 0.12);
                        g.gain.setValueAtTime(0.18, now + idx * 0.12);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.6);
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.start(now + idx * 0.12);
                        o.stop(now + idx * 0.12 + 0.6);
                    });
                }
            } catch (e) {
                // 忽略瀏覽器音訊限制錯誤
            }
        }

        window.speakText = function(text, lang = "en-US", rate = 0.95) {
