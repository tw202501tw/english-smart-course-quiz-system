        // ==========================================
        // 結算與 100 分榮譽語音慶祝邏輯
        // ==========================================
        async function finishQuizAndShowResult() {
            const total = appState.quizQuestions.length;
            const finalScore = Math.round((appState.correctCount / total) * 100);
            appState.score = finalScore;

            const preset = UNIT_PRESETS.find(p => p.id === appState.selectedPresetId) || UNIT_PRESETS[0];
            const typeNames = { mixed: "混合題型", cloze: "例句填空", en2zh: "英翻中", zh2en: "中翻英" };

            // 準備成績 Payload
            const resultPayload = {
                localId: `rec_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
                studentName: appState.studentName,
                education: appState.education,
                grade: appState.grade,
                unit: preset.label,
                questionType: typeNames[appState.questionType] || "混合題型",
                totalQuestions: total,
                correctCount: appState.correctCount,
                score: finalScore,
                timestamp: Date.now(),
                dateStr: new Date().toLocaleString("zh-TW", { hour12: false })
            };
            appState.lastResultPayload = resultPayload;

            // 更新結算畫面 UI
            document.getElementById("resultStudentMeta").textContent = `${appState.studentName} ｜ ${appState.education}・${appState.grade} ｜ 範圍：${preset.label}`;
            document.getElementById("resultScoreNumber").textContent = finalScore;
            document.getElementById("resultCorrectRatio").textContent = `答對 ${appState.correctCount} / ${total} 題`;

            const summaryCard = document.getElementById("resultSummaryCard");
            const honorBadge = document.getElementById("honorBadgeContainer");
            const replayVoiceBox = document.getElementById("replayHonorVoiceBox");
            const headline = document.getElementById("resultHeadline");

            if (finalScore === 100) {
                summaryCard.classList.add("gold-honor-card");
                honorBadge.classList.remove("hidden");
                replayVoiceBox.classList.remove("hidden");
                headline.textContent = "完美滿分！榮耀殿堂達成！";
                // 觸發彩帶特效與祖傳榮譽語音
                try {
                    if (typeof confetti === "function") {
                        confetti({ particleCount: 130, spread: 80, origin: { y: 0.6 } });
                    }
                } catch (_) {}
                window.playHonorSpeech();
            } else {
                summaryCard.classList.remove("gold-honor-card");
                honorBadge.classList.add("hidden");
                replayVoiceBox.classList.add("hidden");
                headline.textContent = finalScore >= 80 ? "表現非常優秀！繼續加油！" : "測驗完成！看看錯題解析吧！";
            }

            // 渲染錯題列表
            const wrongSection = document.getElementById("wrongQuestionsSection");
            const wrongListEl = document.getElementById("wrongQuestionsList");
            if (appState.wrongList.length > 0) {
                wrongSection.classList.remove("hidden");
                document.getElementById("wrongCountBadge").textContent = appState.wrongList.length;
                wrongListEl.innerHTML = appState.wrongList.map((w, i) => `
                    <div class="p-4 rounded-2xl bg-white/90 border border-rose-200 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-slate-800 text-base">${i + 1}. ${w.word} <span class="text-purple-700 font-bold text-sm">(${w.zh})</span></span>
                            <button onclick="window.speakText('${w.word.replace(/'/g, "\\'")}')" class="text-indigo-600 hover:text-indigo-800 text-sm">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                        </div>
                        <div class="text-xs sm:text-sm flex flex-wrap gap-x-4 gap-y-1">
                            <span class="text-rose-600 font-bold"><i class="fa-solid fa-xmark mr-1"></i>您的作答：${w.userAnswer}</span>
                            <span class="text-emerald-600 font-bold"><i class="fa-solid fa-check mr-1"></i>正確答案：${w.correctAnswer}</span>
                        </div>
                        <p class="text-xs text-slate-600 pt-1">${window.highlightBlank(w.example, w.word, false)} — ${w.exampleZh}</p>
                    </div>
                `).join("");
            } else {
                wrongSection.classList.add("hidden");
            }

            switchView("view-result");

            // 自動觸發成績上傳至雲端 (含防呆重試與斷線本機暫存)
            await window.uploadCurrentResult();
        }

        // RULE 6: 成績上傳至雲端按鈕與自動重連防呆機制
        window.uploadCurrentResult = async function() {
            const payload = appState.lastResultPayload;
            if (!payload) return;

            const statusMsg = document.getElementById("uploadStatusMessage");
            const statusBanner = document.getElementById("uploadStatusBanner");
            const uploadBtn = document.getElementById("manualUploadBtn");

            uploadBtn.disabled = true;
            uploadBtn.classList.add("opacity-70", "cursor-not-allowed");
            statusBanner.className = "text-sm font-bold text-indigo-700 flex items-center justify-center gap-2";
            statusMsg.textContent = "上傳中... 正在同步至教師雲端資料庫";

            try {
                if (!navigator.onLine) {
                    throw new Error("目前無網路連線");
                }
                await writeScoreWithRetry(payload, 2);

                // 上傳成功
                statusBanner.className = "text-sm font-extrabold text-emerald-600 flex items-center justify-center gap-2";
                statusMsg.textContent = "上傳成功 ☁️ 成績已安全送達教師後台！";
                uploadBtn.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>已完成雲端上傳</span>`;
                showToast("成績已成功上傳至雲端！☁️", "success");
            } catch (err) {
                // 上傳失敗或離線：自動暫存至 safeStorage 並提示
                saveScoreToPendingQueue(payload);
                statusBanner.className = "text-sm font-bold text-amber-600 flex items-center justify-center gap-2";
                statusMsg.textContent = "上傳失敗，已存至本機並嘗試重連";
                uploadBtn.disabled = false;
                uploadBtn.classList.remove("opacity-70", "cursor-not-allowed");
                uploadBtn.innerHTML = `<i class="fa-solid fa-rotate"></i> <span>重新嘗試上傳至雲端</span>`;
                showToast("連線不穩，成績已安全暫存於本機，將於連線恢復後自動補傳。", "warning");
            }
        };

